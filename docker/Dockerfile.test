# Linux test image: system Chromium, Xvfb/xdotool/x11vnc, ImageMagick and the
# pinned Lightpanda. Runs the whole suite (including the Linux-only
# computer-use tests) under a virtual display.
# Debian 13 (trixie): Lightpanda 1.0.x Linux binaries need glibc >= 2.38 (bookworm has 2.36)
FROM node:22.23.4-trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium xvfb xauth xdotool x11vnc imagemagick \
      procps iproute2 ca-certificates curl fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
ENV PUPPETEER_SKIP_DOWNLOAD=1
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY . .
RUN node scripts/install-lightpanda.js && ./bin/lightpanda version

# Containers run as root without user namespaces: Chrome's sandbox cannot start.
ENV BNCA_CHROME_NO_SANDBOX=1 \
    BNCA_CHROME_PATH=/usr/bin/chromium \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    NODE_OPTIONS=--max-old-space-size=2048

# The visual-mode tests need a display; LocalProvider tests spawn their own Xvfb.
# Start Xvfb directly: xvfb-run (trixie) hung after the command finished and
# never returned. Node 22's --test takes glob patterns, not a bare directory.
CMD ["sh", "-c", "Xvfb :99 -screen 0 1280x800x24 -nolisten tcp >/dev/null 2>&1 & export DISPLAY=:99; sleep 1; exec node --test --test-timeout=180000 'test/*.test.mjs'"]
